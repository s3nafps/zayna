# Copy to .env (local) or set in the environment (Docker). Never commit real values.
# Courier credentials are NOT env vars. They are entered in /admin/carriers and stored encrypted.

# --- Core ---
DATABASE_URL="postgresql://zayna:change-me@localhost:5432/zayna?schema=public"
REDIS_URL="redis://localhost:6379"
# Public origin of the back-office. For the Android build it must be HTTPS (android:config refuses plain HTTP).
APP_URL="http://localhost:3000"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# 32-byte key, base64. Generate with: openssl rand -base64 32
CARRIER_ENCRYPTION_KEY=""

# --- Shopify (filled in during Phase 2) ---
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
# Optional legacy static Admin token. Used only if set.
SHOPIFY_ADMIN_TOKEN=""
SHOPIFY_STOREFRONT_TOKEN=""
SHOPIFY_WEBHOOK_SECRET=""
SHOPIFY_API_VERSION=""

# --- Optional marketing pixels (Phase 6) ---
META_PIXEL_ID=""
META_CAPI_TOKEN=""

# --- First owner account (created by db:seed; existing accounts are never changed) ---
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# --- Docker Compose only ---
POSTGRES_PASSWORD="change-me"
APP_DOMAIN="localhost"

# --- Dev fixtures (never set in production) ---
# Set to 1 with db:seed:fixtures to load clearly fake orders for the dashboard.
ZAYNA_SEED_FIXTURES="0"

# --- Testing ---
# Set to 1 to expose /[locale]/preview/components (component fixtures). Never set in production.
ZAYNA_PREVIEW="0"
