{
  "name": "zayna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zayna: COD jewelry storefront and back-office for Algeria, built around Shopify",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . && node scripts/check-logical-props.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "postinstall": "prisma generate",
    "db:seed:fixtures": "tsx --env-file-if-exists=.env prisma/seed-fixtures.ts"
  },
  "dependencies": {
    "@fontsource/amiri": "5.2.5",
    "@fontsource/cairo": "5.2.5",
    "@fontsource/playfair-display": "5.2.8",
    "@fontsource/plus-jakarta-sans": "5.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.2.3",
    "material-symbols": "0.47.6",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prisma": "7.10.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
